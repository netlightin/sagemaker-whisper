{
  "productName": "Audio Transcriber",
  "version": "0.1.0",
  "identifier": "com.audiotranscriber.app",
  "build": {
    "beforeBuildCommand": "npm run next:build",
    "beforeDevCommand": "npm run next:dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Audio Transcriber",
        "width": 600,
        "height": 700,
        "minWidth": 600,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  }
}
