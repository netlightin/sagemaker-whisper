FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# -------------------------------------------------------------------
# System dependencies
# -------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-dev \
    python3-pip \
    ffmpeg \
    libsndfile1 \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/bin/python

# Upgrade pip tooling
RUN python -m pip install --upgrade pip setuptools wheel

# -------------------------------------------------------------------
# PyTorch (CUDA 12.x)
# -------------------------------------------------------------------
RUN pip install --no-cache-dir \
    torch \
    torchaudio \
    --index-url https://download.pytorch.org/whl/cu121

# faster-whisper + CTranslate2
RUN pip install --no-cache-dir \
    faster-whisper \
    ctranslate2

# audio stack
RUN pip install --no-cache-dir \
    librosa \
    soundfile \
    scipy

# serving
RUN pip install --no-cache-dir \
    flask \
    gunicorn

# -------------------------------------------------------------------
# App setup
# -------------------------------------------------------------------
RUN mkdir -p /opt/ml/model /opt/ml/code
WORKDIR /opt/ml/code

COPY steep_hill/inference.py /opt/ml/code/inference.py
COPY serve_flask.py /opt/ml/code/serve_flask.py
COPY serve /opt/ml/code/serve
RUN chmod +x /opt/ml/code/serve

ENV SAGEMAKER_PROGRAM=serve_flask.py
ENV PATH="/opt/ml/code:/usr/local/bin:${PATH}"

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
 CMD curl -f http://localhost:8080/ping || exit 1

ENTRYPOINT []
CMD ["serve"]